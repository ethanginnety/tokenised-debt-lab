# Copy to .env and adjust. Never put real secrets in this file or in git.

# offline = illustrative curves (development only); online = official daily sources
DEBTLAB_DATA_MODE=offline

# SQLite file holding the audit log, stored curves and the holder ledger.
# Point it at data/scenario.sqlite3 (made by scripts/new_scenario_db.py) to run lifecycle demos.
DEBTLAB_DB_PATH=data/debtlab.sqlite3

# A daily curve older than this many hours is flagged stale and blocks risk-taking
DEBTLAB_MAX_CURVE_AGE_HOURS=96

# Leave empty for today (UTC); set YYYY-MM-DD to reprice as of another date
DEBTLAB_SETTLEMENT_DATE=

DEBTLAB_INSTRUMENTS=config/instruments.json
# Fictional test holders and their starting positions
DEBTLAB_HOLDERS=config/holders.json
# The simulated market maker's parties and starting book
DEBTLAB_MARKETMAKER=config/marketmaker.json
DEBTLAB_HOST=127.0.0.1
DEBTLAB_PORT=8000

# --- Later milestones (not used yet) ---
# XRPL_NETWORK=testnet
# XRPL_SIGNING_KEY=   # load from a secure store; never commit, print or log
